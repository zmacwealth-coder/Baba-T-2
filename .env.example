# Database Connection String (PostgreSQL)
# Works directly with Vercel Postgres, Neon, Supabase, or Railway
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/ogabassey_db?sslmode=require"

# Paystack Gateway Keys (Optional for live payments)
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"
